{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker that already exists in the Cloudflare account (Workers → migweb).
  "name": "migweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  // public/ holds /ledger/ and its files. Everything else reaches
  // src/worker.js: / and /rpc (the whole app, src/app.js) and /api/….
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "SUPABASE_URL": "https://bzjwdpxygozgdwpdzixr.supabase.co",
    "FIREBASE_PROJECT_ID": "cresrxdemo"
  },
  // APP_EXEC_URL (the Apps Script deployment's …/exec address), SUPABASE_SECRET_KEY
  // and ALLOWED_EMAILS are set once in the
  // dashboard (Settings → Variables and Secrets) or with `npx wrangler secret
  // put NAME`; they are never in this file. See README.md.
  "keep_vars": true
}
