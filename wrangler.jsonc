{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker that already exists in the Cloudflare account (Workers → migweb).
  "name": "migweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  // public/ holds /ledger/ and its files. Everything else reaches
  // src/worker.js: / and /rpc (the whole app, src/app.js) and /api/….
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "SUPABASE_URL": "https://bzjwdpxygozgdwpdzixr.supabase.co",
    // Where the project's database is (Mumbai): the Edge Function that runs
    // the app's reads is asked to run there too (src/runner.js).
    "SUPABASE_REGION": "ap-south-1",
    "FIREBASE_PROJECT_ID": "cresrxdemo"
  },
  // APP_EXEC_URL (the Apps Script deployment's …/exec address), SUPABASE_SECRET_KEY
  // and ALLOWED_EMAILS are set once in the
  // dashboard (Settings → Variables and Secrets) or with `npx wrangler secret
  // put NAME`; they are never in this file. See README.md.
  "keep_vars": true,
  // Preview builds (every branch but main, e.g. a pull request's): Cloudflare
  // refuses to build one without this block. A preview sends every call to
  // Apps Script (EDGE_OFF=all) and, given no Supabase key, never calls
  // Supabase, so it touches no data of its own.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://bzjwdpxygozgdwpdzixr.supabase.co",
      "SUPABASE_REGION": "ap-south-1",
      "FIREBASE_PROJECT_ID": "cresrxdemo",
      "EDGE_OFF": "all"
    }
  }
}
