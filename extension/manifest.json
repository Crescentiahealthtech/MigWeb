{
  "manifest_version": 3,
  "name": "CresRx Lab Import",
  "version": "0.1.2",
  "description": "Sends the TN HMIS lab report you are looking at to the CresRx web app.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send lab report to CresRx"
  },
  "options_page": "options.html",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "host_permissions": [
    "https://tnhmislims.org/*",
    "https://*.tnhmislims.org/*"
  ]
}
